{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.vge_horse": {
      "part_visibility": [
        {
          "Saddle": "query.is_saddled"
        },
        {
          "Bit*": "query.is_saddled"
        },
        {
          "Bridle": "query.is_saddled"
        },
        {
          "Reins*": "query.is_saddled && query.has_rider"
        },
        {
          "Bag*": false
        },
        {
          "MuleEar*": false
        }
      ],
      "arrays": {
        "textures": {
          "Array.base": [
            "Texture.base_white",
            "Texture.base_creamy",
            "Texture.base_chestnut",
            "Texture.base_brown",
            "Texture.base_black",
            "Texture.base_gray",
            "Texture.base_darkbrown"
          ],
          "Array.markings": [
            "Texture.markings_none",
            "Texture.markings_white",
            "Texture.markings_whitefield",
            "Texture.markings_whitedots",
            "Texture.markings_blackdots"
          ],
          "Array.armor": [
            "Texture.armor_none",
            "Texture.armor_leather",
            "Texture.armor_iron",
            "Texture.armor_gold",
            "Texture.armor_diamond",
            "Texture.armor_copper",
            "Texture.armor_netherite"
          ],
          "Array.baby_base": [
            "Texture.baby_base_white",
            "Texture.baby_base_creamy",
            "Texture.baby_base_chestnut",
            "Texture.baby_base_brown",
            "Texture.baby_base_black",
            "Texture.baby_base_gray",
            "Texture.baby_base_darkbrown"
          ],
          "Array.baby_markings": [
            "Texture.markings_none",
            "Texture.baby_markings_white",
            "Texture.baby_markings_whitefield",
            "Texture.baby_markings_whitedots",
            "Texture.baby_markings_blackdots"
          ],
          "Array.vge_armor": [
            "Texture.vge_armor_0",
            "Texture.vge_armor_1",
            "Texture.vge_armor_2",
            "Texture.vge_armor_3",
            "Texture.vge_armor_4",
            "Texture.vge_armor_5",
            "Texture.vge_armor_6",
            "Texture.vge_armor_7",
            "Texture.vge_armor_8",
            "Texture.vge_armor_9",
            "Texture.vge_armor_10",
            "Texture.vge_armor_11",
            "Texture.vge_armor_12",
            "Texture.vge_armor_13",
            "Texture.vge_armor_14",
            "Texture.vge_armor_15",
            "Texture.vge_armor_16",
            "Texture.vge_armor_17"
          ]
        }
      },
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.baby_base[query.variant] : Array.base[query.variant]",
        "query.is_baby ? Array.baby_markings[query.mark_variant] : Array.markings[query.mark_variant]",
        "query.is_baby ? Texture.armor_none : variable.vge_armor > 0 ? Array.vge_armor[variable.vge_armor - 1] : Array.armor[variable.armor_texture_slot]"
      ],
      "color": {
        "r": "variable.vge_armor == 0 && variable.armor_texture_slot ? query.armor_color_slot(4, 0) : this",
        "g": "variable.vge_armor == 0 && variable.armor_texture_slot ? query.armor_color_slot(4, 1) : this",
        "b": "variable.vge_armor == 0 && variable.armor_texture_slot ? query.armor_color_slot(4, 2) : this",
        "a": "variable.vge_armor == 0 && variable.armor_texture_slot ? query.armor_color_slot(4, 3) : this"
      }
    }
  }
}