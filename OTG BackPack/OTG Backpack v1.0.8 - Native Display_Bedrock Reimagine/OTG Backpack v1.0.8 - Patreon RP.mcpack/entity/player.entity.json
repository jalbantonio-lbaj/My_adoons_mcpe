                "otg_backpack_native_19": "animation.otg.native_backpack_19",
                "otg_backpack_native_20": "animation.otg.native_backpack_20",
                "otg_backpack_native_21": "animation.otg.native_backpack_21",
                "otg_backpack_native_22": "animation.otg.native_backpack_22",
                "otg_backpack_native_23": "animation.otg.native_backpack_23",
                "otg_backpack_native_24": "animation.otg.native_backpack_24",
                "otg_native_backpack_controller": "controller.animation.otg.native_backpack"
            },
            "render_controllers": [
                {
                    "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator"
                },
                {
                    "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator"
                },
                {
                    "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator"
                },
                {
                    "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator"
                },
                {
                    "controller.render.player.map": "variable.map_face_icon"
                },
                {
                    "controller.render.otg_native_backpack": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator"
                }
            ],
            "enable_attachables": true
        }
    }
}