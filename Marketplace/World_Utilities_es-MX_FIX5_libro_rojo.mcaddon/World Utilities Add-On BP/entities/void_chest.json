{
    "format_version": "1.16.0",
    "minecraft:entity": {
        "description": {
            "identifier": "gf_wu:void_chest_entity",
            "is_summonable": true,
            "is_spawnable": false,
            "scripts": {
                "animate": [
                    "execute_commands"
                ]
            },
            "animations": {
                "execute_commands": "controller.animation.gf_wu.void_chest.execute_commands"
            }
        },
        "component_groups": {
            "in_container": {
                "minecraft:entity_sensor": {
                    "sensor_range": 7,
                    "event_filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            {
                                "test": "has_container_open",
                                "subject": "other",
                                "value": false
                            }
                        ]
                    },
                    "event": "not_in_container"
                }
            },
            "not_in_container": {
                "minecraft:entity_sensor": {
                    "sensor_range": 7,
                    "event_filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            {
                                "test": "has_container_open",
                                "subject": "other",
                                "value": true
                            }
                        ]
                    },
                    "event": "in_container"
                }
            },
            "despawn": {
                "minecraft:instant_despawn": {
                    "remove_child_entities": false
                }
            },
            "execute_command_id_1": {
                "minecraft:skin_id": {
                    "value": 1
                }
            },
            "execute_no_command": {
                "minecraft:skin_id": {
                    "value": 0
                }
            }
        },
        "components": {
            "minecraft:knockback_resistance": {
                "value": 1
            },
            "minecraft:collision_box": {
                "height": 1.2,
                "width": 0.8
            },
            "minecraft:health": {
                "value": 1,
                "min": 1
            },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "on_damage": { },
                        "deals_damage": false
                    }
                ]
            },
            "minecraft:fire_immune": { },
            "minecraft:inside_block_notifier": {
                "block_list": [
                    {
                        "block": { "name": "gf_wu:void_chest" },
                        "exited_block_event": {
                            "event": "exit"
                        }
                    }
                ]
            },
            "minecraft:physics": { },
            "minecraft:inventory": {
                "additional_slots_per_strength": 0,
                "container_type": "container",
                "inventory_size": 27
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "not_in_container"
                    ]
                }
            },
            "poof": {
                "add": {
                    "component_groups": [
                        "despawn"
                    ]
                }
            },
            "in_container": {
                "remove": {
                    "component_groups": [
                        "not_in_container"
                    ]
                },
                "add": {
                    "component_groups": [
                        "in_container"
                    ]
                }
            },
            "not_in_container": {
                "remove": {
                    "component_groups": [
                        "in_container"
                    ]
                },
                "add": {
                    "component_groups": [
                        "not_in_container",
                        "execute_command_id_1"
                    ]
                }
            },
            "remove_command_id_1": {
                "add": {
                    "component_groups": [
                        "execute_no_command"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "execute_command_id_1"
                    ]
                }
            },
            "exit": {
                "queue_command": {
                    "command": "event entity @s poof"
                }
            }
        }
    }
}