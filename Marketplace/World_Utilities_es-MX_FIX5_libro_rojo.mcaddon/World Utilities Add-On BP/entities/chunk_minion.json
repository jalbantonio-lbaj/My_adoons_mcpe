{
    "format_version": "1.16.0",
    "minecraft:entity": {
        "description": {
            "identifier": "gf_wu:chunk_minion",
            "is_summonable": true,
            "is_spawnable": false,
            "properties": {
                "gf_wu:size": {
                    "type": "int",
                    "range": [ 1, 3 ],
                    "default": 1
                }
            }
        },
        "components": {
            "minecraft:knockback_resistance": {
                "value": 1
            },
            "minecraft:collision_box": {
                "width": 0.8,
                "height": 1.7
            },
            "minecraft:health": {
                "value": 1,
                "min": 1
            },
            "minecraft:persistent": { },
            "minecraft:physics": { },
            "minecraft:damage_sensor": {
                "triggers": [
                    {
                        "on_damage": { },
                        "deals_damage": false
                    }
                ]
            },
            "minecraft:fire_immune": { },
            "minecraft:interact": {
                "interactions": [
                    {
                        "on_interact": {
                            "event": "interact"
                        }
                    }
                ]
            },
            "minecraft:behavior.croak": {
                "priority": 0,
                "duration": [
                    1,
                    1
                ],
                "interval": [ 120, 120 ]
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "trigger": "size_1"
            },
            "interact": {
                "queue_command": {
                    "command": "scriptevent gf_wu:chunk_minion_interaction",
                    "target": "other"
                }
            },
            "poof": { },
            "size_1": {
                "set_property": {
                    "gf_wu:size": 1
                }
            },
            "size_2": {
                "set_property": {
                    "gf_wu:size": 2
                }
            },
            "size_3": {
                "set_property": {
                    "gf_wu:size": 3
                }
            }
        }
    }
}