{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.gf_wu.vault": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "opening": "query.property('gf_wu:open')"
            }
          ]
        },
        "opening": {
          "animations": [
            "open"
          ],
          "transitions": [
            {
              "closing": "!query.property('gf_wu:open')"
            }
          ]
        },
        "closing": {
          "animations": [
            "close"
          ],
          "transitions": [
            {
              "opening": "query.property('gf_wu:open')"
            }
          ]
        }
      }
    }
  }
}
