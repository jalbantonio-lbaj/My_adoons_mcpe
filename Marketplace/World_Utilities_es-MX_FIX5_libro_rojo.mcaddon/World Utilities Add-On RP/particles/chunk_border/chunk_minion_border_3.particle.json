{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "gf_wu:chunk_minion_border_3",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/gamefam/world_utils/chunk_minion_border"
			}
		},
		"components": {
			"minecraft:emitter_initialization": {
				"creation_expression": "variable.radius = 5.0;variable.size = variable.radius * 8;"
			},
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": false
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 44
			},
			"minecraft:emitter_lifetime_looping": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [ "variable.particle_random_1 < 0.25 ? 0 :(variable.particle_random_1 < 0.50 ? 0 :(variable.particle_random_1 < 0.75 ? variable.size :-variable.size))", 0, "variable.particle_random_1 < 0.25 ? variable.size :(variable.particle_random_1 < 0.50 ? -variable.size :(variable.particle_random_1 < 0.75 ? 0 :0))" ]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 9
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": { },
			"minecraft:particle_appearance_billboard": {
				"size": [ "variable.size", 192 ],
				"facing_camera_mode": "direction_z",
				"direction": {
					"mode": "custom",
					"custom_direction": [ "variable.particle_random_1 < 0.25 ? 0 :(variable.particle_random_1 < 0.50 ? 0 :(variable.particle_random_1 < 0.75 ? 1 :1))", "variable.particle_random_1 < 0.25 ? 0 :(variable.particle_random_1 < 0.50 ? 0 :(variable.particle_random_1 < 0.75 ? 0 :0))", "variable.particle_random_1 < 0.25 ? 1 :(variable.particle_random_1 < 0.50 ? -1 :(variable.particle_random_1 < 0.75 ? 0 :0))" ]
				},
				"uv": {
					"texture_width": 256,
					"texture_height": 1,
					"uv": [ 0, 0 ],
					"uv_size": [ 256, 1 ]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#14FFFFFF",
						"0.27": "#14FFFFFF",
						"0.65": "#14FFFFFF",
						"1.0": "#14FFFFFF"
					}
				}
			}
		}
	}
