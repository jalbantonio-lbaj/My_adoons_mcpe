            "minecraft:particle_appearance_billboard": {
                "size": [ 0.175, 0.175 ],
                "facing_camera_mode": "lookat_xyz",
                "uv": {
                    "texture_width": 128,
                    "texture_height": 128,
                    "uv": [ "24+Math.Round(variable.particle_random_1*3.0)*8", 8 ],
                    "uv_size": [ 8, 8 ]
                }
            },
            "minecraft:particle_appearance_tinting": {
                "color": [ 1.0, 1.0, 1.0, 1.0 ]
