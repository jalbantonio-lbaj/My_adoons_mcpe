{
  "format_version": "1.26.1",
  "minecraft:block": {
    "description": {
      "identifier": "mikeyz:neon_magenta_light",
      "menu_category": {
        "category": "construction"
      },
      "states": {
        "mikeyz:light": [
          0,
          1
        ]
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:facing_direction"
          ]
        }
      }
    },
    "components": {
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 2
      },
      "minecraft:collision_box": {
        "origin": [
          -5,
          3,
          4
        ],
        "size": [
          10,
          10,
          4
        ]
      },
      "minecraft:selection_box": {
        "origin": [
          -5,
          3,
          4
        ],
        "size": [
          10,
          10,
          4
        ]
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 30
      },
      "minecraft:geometry": "geometry.neon_blue_light",
      "minecraft:material_instances": {
        "*": {
          "texture": "neon_light_off",
          "render_method": "opaque",
          "face_dimming": false,
          "ambient_occlusion": false
        }
      },
      "minecraft:item_visual": {
        "geometry": "geometry.neon_blue_light",
        "material_instances": {
          "*": {
            "texture": "neon_magenta_light",
            "render_method": "opaque",
            "face_dimming": true,
            "ambient_occlusion": true
          }
        }
      },
      "minecraft:connection_rule": {
        "accepts_connections_from": "none"
      },
      "minecraft:map_color": "#ffffff",
      "minecraft:liquid_detection": {
        "detection_rules": [
          {
            "liquid_type": "water",
            "on_liquid_touches": "no_reaction"
          }
        ]
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'north'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              180,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'south'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'east'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              90,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'west'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              270,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'up'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              -90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('minecraft:facing_direction') == 'down'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      },
      {
        "condition": "q.block_state('mikeyz:light') == 1",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "neon_magenta_light",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 10
        }
      },
      {
        "condition": "q.block_state('mikeyz:light') == 0",
        "components": {
          "minecraft:material_instances": {
            "*": {
              "texture": "neon_light_off",
              "render_method": "opaque"
            }
          },
          "minecraft:light_emission": 0
        }
      }
    ]
  }
}
