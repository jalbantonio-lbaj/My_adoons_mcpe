{
	"format_version": "1.20.60",
	"minecraft:entity": {
		"description": {
			"identifier": "extra_utilities:trash_can",
			"is_spawnable": false,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"extra_utilities:despawn": {
				"minecraft:instant_despawn": {
					"remove_child_entities": false
				}
			}
		},
		"components": {
			"minecraft:type_family": {
				"family": [
					"chest",
					"inanimate"
				]
			},
			"minecraft:collision_box": {
				"height": 0,
				"width": 0
			},
			"minecraft:custom_hit_test": {
				"hitboxes": [
					{
						"width": 1,
						"height": 0.25,
						"pivot": [
							0,
							0.5,
							0
						]
					}
				]
			},
			"minecraft:health": {
				"value": 1
			},
			"minecraft:fire_immune": {},
			"minecraft:damage_sensor": {
				"triggers": {
					"cause": "all",
					"deals_damage": false
				}
			},
			"minecraft:inventory": {
				"can_be_siphoned_from": true,
				"inventory_size": 1,
				"container_type": "inventory"
			},
			"minecraft:nameable": {
				"allow_name_tag_renaming": false,
				"always_show": false
			},
			"minecraft:timer": {
				"time": 0.1,
				"looping": true,
				"time_down_event": {
					"event": "tick",
					"target": "self"
				}
			}
		},
		"events": {
			"extra_utilities:despawn_chest": {
				"add": {
