						"extra_utilities:despawn"
					]
				}
			},
			"tick": {
				"queue_command": {
					"command": [
						"execute if block ~~~ air run event entity @s extra_utilities:despawn_chest",
						"replaceitem entity @s slot.inventory 0 air"
					]
				}
			}
		}
