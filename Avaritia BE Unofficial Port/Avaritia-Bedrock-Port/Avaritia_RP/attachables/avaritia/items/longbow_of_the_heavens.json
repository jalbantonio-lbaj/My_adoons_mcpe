{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "avaritia:longbow_of_the_heavens",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/infinity_bow_standby",
        "infinity_bow_pulling_0": "textures/items/infinity_bow_pulling_0",
        "infinity_bow_pulling_1": "textures/items/infinity_bow_pulling_1",
        "infinity_bow_pulling_2": "textures/items/infinity_bow_pulling_2",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.avaritia.longbow_standby",
        "pulling_0": "geometry.avaritia.longbow_pulling_0",
        "pulling_1": "geometry.avaritia.longbow_pulling_1",
        "pulling_2": "geometry.avaritia.longbow_pulling_2"
      },
      "animations": {
        "wield": "animation.bow.wield",
        "wield_first_person_pull": "animation.bow.wield_first_person_pull"
      },
      "scripts": {
        "pre_animation": [
          "variable.max_animation_duration = 10.0;",
          "variable.charge_amount = math.clamp((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / variable.max_animation_duration, 0.0, 1.0f);",
          "variable.bow_tex_idx = query.main_hand_item_use_duration > 0.0f ? math.min(math.max(1, math.floor((query.main_hand_item_max_duration - (query.main_hand_item_use_duration - query.frame_alpha + 1.0)) / variable.max_animation_duration * 3) + 1), 3) : 0;"
        ],
        "animate": [
          "wield",
          {
            "wield_first_person_pull": "query.main_hand_item_use_duration > 0.0f && c.is_first_person"
          }
        ]
      },
      "render_controllers": [
        "controller.render.infinity_bow"
      ]
    }
  }
}
