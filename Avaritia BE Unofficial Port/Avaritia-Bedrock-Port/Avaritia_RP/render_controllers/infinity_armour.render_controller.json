{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.armor.animate": {
      "arrays": {
        "textures": {
          "array.frames": [
            "texture.frame_1", "texture.frame_2", "texture.frame_3", "texture.frame_4",
            "texture.frame_5", "texture.frame_6", "texture.frame_7", "texture.frame_8",
            "texture.frame_9", "texture.frame_8", "texture.frame_7", "texture.frame_6",
            "texture.frame_5", "texture.frame_4", "texture.frame_3", "texture.frame_2",
            "texture.frame_1"
          ]
        }
      },
      "geometry": "Geometry.default",
      "textures": [ 
        "return array.frames[math.mod(query.life_time * 12.0, 17.0)];" 
      ],
      "materials": [ { "*": "Material.default" } ]
    },
    "controller.render.armor.normal": {
      "geometry": "Geometry.default",
      "materials": [ { "*": "Material.default" } ],
      "textures": [ "Texture.default" ]
    },
    "controller.render.shield_armor": {
      "geometry": "Geometry.shield",
      "part_visibility": [ 
        { "*": "query.equipped_item_any_tag('slot.armor.head','avaritia_armor') && query.equipped_item_any_tag('slot.armor.chest','avaritia_armor') && query.equipped_item_any_tag('slot.armor.legs','avaritia_armor') && query.equipped_item_any_tag('slot.armor.feet','avaritia_armor')" } 
      ],
      "materials": [ 
        { "bone_shield*": "Material.cosmic_shield" },
        { "bone_outline_in*": "Material.outline_inner" },
        { "bone_outline_out*": "Material.outline_outer" },
        { "*": "Material.cosmic_shield" }
      ],
      "textures": [ "texture.cosmic" ]
    },
  "controller.render.avaritia.wings": {
    "arrays": {
      "textures": {
        "array.frames": [
          "texture.wing1", "texture.wing2", "texture.wing3", "texture.wing4", "texture.wing5",
          "texture.wing6", "texture.wing7", "texture.wing8", "texture.wing9", "texture.wing10"
        ]
      }
    },
    "geometry": "geometry.wing",
    "textures": [
      "return array.frames[math.mod(query.life_time * 15.0, 10.0)];"
    ],
    "part_visibility": [
      { "*": "query.equipped_item_any_tag('slot.armor.chest', 'avaritia_winged')" }
    ],
    "materials": [
      { "*": "Material.default" }
    ]
  },
    "controller.render.rainbow_eyes": {
      "arrays": {
        "textures": {
          "array.frames": [
            "texture.frame_1", "texture.frame_2", "texture.frame_3", "texture.frame_4",
            "texture.frame_5", "texture.frame_6", "texture.frame_7", "texture.frame_8",
            "texture.frame_9"
          ]
        }
      },
      "geometry": "Geometry.eyes",
      "textures": [ 
        "return array.frames[math.mod(query.life_time * 10.0, 9.0)];" 
      ],
      "part_visibility": [ 
        { "*": "query.equipped_item_any_tag('slot.armor.head','avaritia_armor') && query.equipped_item_any_tag('slot.armor.chest','avaritia_armor') && query.equipped_item_any_tag('slot.armor.legs','avaritia_armor') && query.equipped_item_any_tag('slot.armor.feet','avaritia_armor')" } 
      ],
      "materials": [ { "*": "Material.default" } ]
    }
  }
}