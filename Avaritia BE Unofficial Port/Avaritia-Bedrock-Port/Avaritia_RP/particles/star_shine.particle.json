{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "avaritia:star_shine",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/star_shine"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 3,
        "max_particles": 60
      },
      "minecraft:emitter_shape_point": {},
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random_integer(9, 12)"
      },
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(-90,90)",
        "rotation_rate": "math.random(-90,90)"
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_motion_dynamic": {},
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.particle_random_3 * 10 + (v.particle_age / v.particle_lifetime) * 5) * query.property('avaritia:scale')",
          "(1.4 + math.sin(v.particle_age * 90) * 0.7) * query.property('avaritia:scale')"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 256,
          "texture_height": 256,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            256,
            256
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFFFFF",
            "0.08": "#FFFFEF00",
            "0.2": "#ffffffff",
            "0.35": "#FFFF6100",
            "0.73": "#FFFF3200",
            "1.0": "#00FFFFFF"
          }
        }
      },
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_lifetime_looping": {
        "active_time": 999999
      }
    }
  }
}