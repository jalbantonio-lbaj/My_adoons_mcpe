            "offset": [148, 27],
            "layer": 2
          }
        },
        {
          "recipe_overlays@avaritia.dire_recipe_overlays": {}
        }
      ]
    },

  "machine_name": {
    "type": "panel",
    "$offset|default": [
      10,
      0
    ],
    "controls": [
      {
        "chest_label": {
