    "$toggle_checked_hover": "textures/ui/slot_enabled_hover",
    "$has_toggle_icon": true,
    "$toggle_icon_size": [14, 14],
    "$toggle_icon_uv_size": [16, 16],
    "$toggle_icon_unchecked": "$recipe_icon",
    "$toggle_icon_checked": "$recipe_icon",
    "$toggle_icon_unchecked_hover": "$recipe_icon",
    "$toggle_icon_checked_hover": "$recipe_icon"
  },

  "recipe_slot_overlay": {
    "type": "panel",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [16, 16],
    "offset": "$slot_offset",
    "$slot_offset|default": [0, 0],
    "$has_slot_item|default": true,
    "$has_slot_flipbook|default": false,
    "$has_slot_hover|default": false,
    "$has_slot_count|default": false,
    "$slot_hover_text|default": "",
    "$slot_count_text|default": "",
    "$slot_item_texture|default": "",
    "$slot_item_flipbook_texture|default": "",
    "$slot_item_flipbook_uv|default": "",
    "$slot_item_offset|default": [0, 0],
    "$slot_item_size|default": [16, 16],
    "$slot_red_size|default": [16, 16],
    "$slot_red_offset|default": [0, 0],
    "$recipe_slot_index|default": 0,
    "collection_index": "$recipe_slot_index",
    "$item_collection_name|default": "container_items",
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux < 1)",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "recipe_item": {
          "type": "image",
          "visible": "$has_slot_item",
          "texture": "$slot_item_texture",
          "size": "$slot_item_size",
          "offset": "$slot_item_offset",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 6
        }
      },
      {
        "recipe_item_flipbook": {
          "type": "image",
          "visible": "$has_slot_flipbook",
          "texture": "$slot_item_flipbook_texture",
          "size": "$slot_item_size",
          "uv_size": [16, 16],
          "uv": "$slot_item_flipbook_uv",
          "offset": "$slot_item_offset",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 6
        }
      },
      {
        "red_image": {
          "type": "image",
          "texture": "textures/ui/red_image",
          "size": "$slot_red_size",
          "offset": "$slot_red_offset",
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "layer": 5
        }
      },
      {
        "recipe_item_count": {
          "type": "label",
          "visible": "$has_slot_count",
          "text": "$slot_count_text",
          "size": [16, 8],
          "offset": "$slot_item_offset",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "text_alignment": "right",
          "color": [1, 1, 1],
          "shadow": true,
          "font_scale_factor": 1,
          "layer": 7
        }
      }
    ]
  },

