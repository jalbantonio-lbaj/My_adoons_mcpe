{
  "namespace": "avaritia",
  "compressor_text_label": {
    "type": "label",
    "text": "#hover_text",
    "color": [255, 255, 255],
    "shadow": false,
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      }
    ]
  },
  "compressor_requirement_label": {
    "type": "label",
    "text": "#hover_text",
    "size": [162, 28],
    "color": [255, 255, 255],
    "shadow": true,
    "text_alignment": "center",
    "font_scale_factor": 1.0,
    "layer": 210,
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_condition": "always",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      }
    ]
  },
  "compressor_in_slot": {
    "type": "collection_panel",
    "collection_name": "container_items",
    "size": [18, 18],
    "controls": [
      {
        "cell@common.container_item": {
          "size": [18, 18],
          "collection_index": "$collection_index",
          "$cell_image_size|default": [18, 18],
          "$item_renderer_panel_size|default": [18, 18]
        }
      }
    ]
  },
  "compressor_out_slot": {
    "type": "collection_panel",
    "collection_name": "container_items",
    "size": [24, 24],
    "controls": [
      {
        "cell@common.container_item": {
          "size": [24, 24],
          "collection_index": "$collection_index",
          "$cell_image_size|default": [24, 24],
          "$item_renderer_panel_size|default": [24, 24]
        }
      }
    ]
  },
  "compressor_arrow": {
    "$collection_index": 2,
    "$collection_name|default": "container_items",
    "$max_stack|default": 63.0,
    "layer": 200,
    "type": "image",
    "texture": "textures/ui/arrow_empty",
    "size": [26, 18],
    "controls": [
      {
        "arrow_fill_wrapper": {
          "type": "collection_panel",
          "size": [26, 18],
          "collection_name": "$collection_name",
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "actual_arrow": {
                "type": "image",
                "size": [26, 18],
                "collection_index": "$collection_index",
                "texture": "textures/ui/arrow_full",
                "clip_direction": "left",
                "clip_pixelperfect": false,
                "bindings": [
                  {
                    "binding_name": "#inventory_stack_count",
                    "binding_name_override": "#stack_count",
                    "binding_condition": "always",
                    "binding_type": "collection",
                    "binding_collection_name": "container_items"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#stack_count = ''))",
                    "target_property_name": "#visible"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#stack_count - '§r' - '§f' - '§o') * 1)",
                    "target_property_name": "#stack_number"
                  },
                  {
                    "binding_condition": "always",
                    "binding_type": "view",
                    "source_property_name": "(1 - ((#stack_number - 1) / $max_stack))",
                    "target_property_name": "#clip_ratio"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "compressor_top": {
    "$show_progress_labels|default": true,
      "type": "collection_panel",
      "anchor_from": "top_left",
      "anchor_to": "top_left",
      "size": [162, 80],
      "offset": [7, 7],
    "collection_name": "container_items",
    "$item_collection_name": "container_items",
    "controls": [
      {
        "machine_name@chest.chest_label": {
          "offset": [0, 0],
          "anchor_from": "top_left",
          "anchor_to": "top_left"
        }
      },
      {
        "input_slot@avaritia.compressor_in_slot": {
          "collection_index": 0,
          "$collection_index": 0,
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [-32, -8]
        }
      },
      {
        "bar@avaritia.compressor_arrow": {
          "$collection_index": 2,
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [0, -8]
        }
      },
      {
        "output_slot@avaritia.compressor_out_slot": {
          "collection_index": 1,
          "$collection_index": 1,
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [32, -8]
        }
      },
      {
        "count_label@avaritia.compressor_text_label": {
          "visible": "$show_progress_labels",
          "collection_index": 2,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 46]
        }
      },
      {
        "name_label@avaritia.compressor_text_label": {
          "visible": "$show_progress_labels",
          "collection_index": 3,
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [0, 56]
        }
      }
    ]
  },
  "compressor_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 14
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {}
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {}
      },
      {
        "root_panel@common.root_panel": {
          "layer": 1,
          "controls": [
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "controls": [
                  {
                    "recipes_side_panel@avaritia.compressor_recipes_side_panel": {}
                  },
                  {
                    "recipes_connector@avaritia.compressor_recipes_connector": {}
                  },
                  {
                    "machine_content": {
                      "type": "panel",
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "avaritia_recipes_toggle_button",
                          "source_property_name": "(not (#toggle_state))",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@common.common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@avaritia.machine_recipe_view_top_bar": {
                            "offset": [37, -91],
                            "$machine_toggle_default_state": true,
                            "$recipes_toggle_default_state": false,
                            "$toggle_group_default_selected": 0,
                            "$machine_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$machine_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover"
                          }
                        },
                        {
                          "compressor_top@avaritia.compressor_top": {}
                        },
                        {
                          "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@common.hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  },
                  {
                    "recipes_content": {
                      "type": "panel",
                      "offset": [76, 0],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "avaritia_recipes_toggle_button",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#visible",
                          "resolve_sibling_scope": false
                        }
                      ],
                      "controls": [
                        {
                          "common_panel@common.common_panel": {
                            "$show_close_button": false
                          }
                        },
                        {
                          "view_top_bar@avaritia.machine_recipe_view_top_bar": {
                            "offset": [37, -91],
                            "$toggle_group_default_selected": 0,
                            "$machine_toggle_checked": "textures/ui/toggle_button/tab",
                            "$machine_toggle_checked_hover": "textures/ui/toggle_button/tab_hover",
                            "$recipes_toggle_unchecked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_checked": "textures/ui/toggle_button/tab_pressed",
                            "$recipes_toggle_unchecked_hover": "textures/ui/toggle_button/tab_hover_pressed",
                            "$recipes_toggle_checked_hover": "textures/ui/toggle_button/tab_hover_pressed"
                          }
                        },
                        {
                          "compressor_top@avaritia.compressor_top": {
                            "$show_progress_labels": false
                          }
                        },
                        {
                          "compressor_recipe_panels@avaritia.compressor_recipe_panels": {}
                        },
                        {
                          "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                        },
                        {
                          "hotbar_grid@common.hotbar_grid_template": {}
                        },
                        {
                          "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            }
          ]
        }
      }
    ]
  }
}
