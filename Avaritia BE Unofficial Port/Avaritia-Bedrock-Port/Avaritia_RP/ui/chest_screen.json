{
  "namespace": "chest",
  "small_chest_screen": {
    "$temp_container_title|default": "$container_title",
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_back",
        "value": [
          {
            "requires": "($temp_container_title = 'entity.avaritia:neutron_collector.name')",
            "$screen_content": "avaritia.collector_panel",
            "$screen_bg_content": "common.screen_background"
          },
          {
            "requires": "($temp_container_title = 'entity.avaritia:neutronium_compressor.name')",
            "$screen_content": "avaritia.compressor_panel",
            "$screen_bg_content": "common.screen_background"
          },
          {
            "requires": "($temp_container_title = 'entity.avaritia:extreme_craft.name')",
            "$screen_content": "avaritia.extreme_craft_screen",
            "$screen_bg_content": "common.screen_background"
          }
        ]
      }
    ]
  }
}
