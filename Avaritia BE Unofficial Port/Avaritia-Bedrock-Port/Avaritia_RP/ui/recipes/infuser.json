{
    "namespace": "uc",
    "infuser_recipes_buttons/addon_recipe_rows": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "avaritia_recipe_rows@uc.avaritia_infuser_recipe_rows": {}
                    }
                ]
            }
        ]
    },
    "infuser_recipes_panel/recipes_panel/addon_recipe_panels": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "avaritia_recipe_panels@uc.avaritia_infuser_recipe_panels": {}
                    }
                ]
            }
        ]
    },
    "avaritia_infuser_recipe_rows": {
        "type": "stack_panel",
        "size": [126, "100%c"],
        "orientation": "vertical",
        "controls": [
            {
                "avaritia_separator@uc.addon_recipe_separator": {
                    "$separator_label": "Avaritia"
                }
            },
            {
                "avaritia_recipe_row_0": {
                    "type": "panel",
                    "size": [126, 18],
                    "controls": [
                        {
                            "avaritia_starfuel_toggle@uc.infuser_recipe_toggle": {
                                "anchor_from": "top_left",
                                "anchor_to": "top_left",
                                "$toggle_index": 10000,
                                "$toggle_hover_text": "item.avaritia:starfuel",
                                "$toggle_control_name": "avaritia_starfuel_recipe",
                                "$recipe_icon": "textures/items/starfuel",
                                "offset": [0, 0]
                            }
                        }
                    ]
                }
            }
        ]
    },
    "avaritia_infuser_recipe_panels": {
        "type": "panel",
        "anchor_from": "center",
        "anchor_to": "center",
        "size": [80, 108],
        "controls": [
            {
                "avaritia_starfuel_panel@uc.recipe_panel": {
                    "$recipe_control_name": "avaritia_starfuel_recipe",
                    "controls": [
                        {
                            "catalyst@uc.infuser_recipe_catalyst": {
                                "$slot_item_texture": "textures/ui/icons/infinity_catalyst",
                                "$slot_hover_text": "item.avaritia:infinity_catalyst",
                                "$has_slot_hover": true
                            }
                        },
                        {
                            "input@uc.infuser_recipe_input": {
                                "$slot_item_texture": "textures/blocks/compressed/coal_4",
                                "$slot_hover_text": "tile.utilitycraft:compressed_coal_block_4.name",
                                "$has_slot_hover": true,
                                "$slot_count_text": "8",
                                "$has_slot_count": true
                            }
                        },
                        {
                            "output@uc.infuser_recipe_output": {
                                "$slot_item_texture": "textures/items/starfuel",
                                "$slot_hover_text": "item.avaritia:starfuel",
                                "$has_slot_hover": true
                            }
                        }
                    ]
                }
            }
        ]
    }
}
