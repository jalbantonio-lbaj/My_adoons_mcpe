  "image_template": {
    "type": "image",
    "texture": "$texture",
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "( #hover_text - ('%.6s' * #hover_text) = $binding_text)",
        "target_property_name": "#visible"
      }
    ]
  },
  "cell_image": {
    "type": "image",
    "texture": "$cell_image_texture",
    "nineslice_size": 1
  },
  "cell_image_selected": {
    "type": "image",
    "texture": "$cell_image_selected_texture",
    "nineslice_size": 1
  },
  "cell_image_panel": {
    "type": "panel",
    "controls": [
      {
        "cell_image@dustveyn_ef_neutronium_compressor.cell_image": {
          "$cell_selected_binding_name|default": "#is_selected_slot",
          "visible": true,
          "bindings": [
            {
              "binding_name": "(not $cell_selected_binding_name)",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ]
        }
      },
      {
        "cell_image_selected@dustveyn_ef_neutronium_compressor.cell_image_selected": {
          "$cell_selected_binding_name|default": "#is_selected_slot",
          "visible": false,
          "bindings": [
            {
              "binding_name": "$cell_selected_binding_name",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ]
        }
      }
    ]
  },
  "highlight_slot": {
    "type": "image",
    "texture": "$highlight_slot_texture",
    "size": [
      "100% - 2px",
      "100% - 2px"
    ],
    "alpha": 0.8
  },
  "highlight_slot_panel": {
    "type": "panel",
    "controls": [
      {
        "highlight@dustveyn_ef_neutronium_compressor.highlight_slot": {
          "controls": [
            {
              "hover_text@common.hover_text": {
                "layer": 29,
                "$hover_text_binding_name|default": "#hover_text",
                "bindings": [
                  {
                    "binding_name": "$hover_text_binding_name",
                    "binding_name_override": "#hover_text",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  }
                ]
              }
            }
          ],
          "bindings": [
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "white_border@common.white_border_slot": {
          "bindings": [
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "container_slot_button_prototype@common.container_slot_button_prototype": {
    "$highlight_control|default": "dustveyn_ef_neutronium_compressor.highlight_slot_panel",
    "$highlight_slot_texture|default": "textures/ui/highlight_slot"
  },
  "text_display": {
    "type": "stack_panel",
    "$index": 0,
    "$collection_name": "collection",
    "size": [
      18,
      18
    ],
    "collection_name": "$collection_name",
    "controls": [
      {
        "text": {
          "type": "label",
          "text": "$hover_text_binding_name",
          "collection_index": "$index",
          "color": "$title_text_color",
          "$hover_text_binding_name": "#hover_text",
          "bindings": [
            {
              "binding_name_override": "#hover_text",
              "binding_name": "$hover_text_binding_name",
              "binding_condition": "always_when_visible",
              "binding_type": "collection",
              "binding_collection_name": "$collection_name"
            }
          ]
        }
      }
    ]
  },
  "container_item": {
    "type": "input_panel",
    "size": [
      18,
      18
    ],
    "layer": 1,
    "$cell_image_size|default": [
      18,
      18
    ],
    "$cell_overlay_ref|default": "common.cell_overlay",
    "$button_ref|default": "dustveyn_ef_neutronium_compressor.container_slot_button_prototype",
    "$stack_count_required|default": true,
    "$durability_bar_required|default": true,
    "$storage_bar_required|default": true,
    "$item_renderer|default": "common.item_renderer",
    "$item_renderer_panel_size|default": [
      18,
      18
    ],
    "$item_renderer_size|default": [
