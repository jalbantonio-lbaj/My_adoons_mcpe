{
  "format_version" : "1.10.0",
  "animation_controllers" : {
    "controller.animation.wing.flying": {
      "initial_state": "first_person",
      "states": {
        "first_person": {
          "animations": [
            "flying"
          ],
          "transitions": [
            {
              "third_person": "query.is_on_ground"
            },
            {
              "third_person": "query.is_in_water"
            }
          ]
        },
        "third_person": {
          "animations": [
            "walking"
          ],
          "transitions": [
            {
              "first_person": "!query.is_gliding && !query.is_sleeping && !query.is_in_water && !query.is_swimming && !query.is_on_ground"
            }
          ]
        }
      }
    }
  }
}