{
    "format_version": "1.26.30",
    "minecraft:block": {
        "description": {
            "identifier": "dustveyn_ef:enhanced_neutron_collector",
            "menu_category": {
                "category": "items"
            },
            "traits": {
                "minecraft:placement_direction": {
                    "enabled_states": [
                        "minecraft:cardinal_direction"
                    ],
                    "y_rotation_offset": 180
                }
            }
        },
        "permutations": [
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'south'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            180,
                            0
                        ]
                    },
                    "minecraft:tags": [
                        "cardinal_direction:south"
                    ]
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'north'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            0,
                            0
                        ]
                    },
                    "minecraft:tags": [
                        "cardinal_direction:north"
                    ]
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'east'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            -90,
                            0
                        ]
                    },
                    "minecraft:tags": [
                        "cardinal_direction:east"
                    ]
                }
            },
            {
                "condition": "query.block_state('minecraft:cardinal_direction') == 'west'",
                "components": {
                    "minecraft:transformation": {
                        "rotation": [
                            0,
                            90,
                            0
                        ]
                    },
                    "minecraft:tags": [
                        "cardinal_direction:west"
                    ]
                }
            }
        ],
        "components": {
            "minecraft:tags": [
                "minecraft:is_pickaxe_item_destructible"
            ],
            "minecraft:destructible_by_mining": {
                "seconds_to_destroy": 8.0
            },
            "minecraft:destructible_by_explosion": {
                "explosion_resistance": 120.0
            },
            "minecraft:geometry": {
                "identifier": "geometry.dustveyn_ef_blocks"
            },
            "minecraft:material_instances": {
                "*": {
                    "texture": "dustveyn_ef:enhanced_neutron_collector_side",
                    "render_method": "alpha_test"
                },
                "side": {
                    "texture": "dustveyn_ef:enhanced_neutron_collector_side",
                    "render_method": "alpha_test"
                },
                "bottom": {
                    "texture": "dustveyn_ef:machine_bottom",
                    "render_method": "alpha_test"
                },
                "top": {
                    "texture": "dustveyn_ef:enhanced_neutron_collector_top",
                    "render_method": "alpha_test"
                },
                "front": {
                    "texture": "dustveyn_ef:enhanced_neutron_collector_front",
                    "render_method": "alpha_test"
                }
            },
            "minecraft:display_name": "§q%dustveyn_ef.enhanced_neutron_collector.name\n§o§9Endless Fabulous"
        }
    }
}