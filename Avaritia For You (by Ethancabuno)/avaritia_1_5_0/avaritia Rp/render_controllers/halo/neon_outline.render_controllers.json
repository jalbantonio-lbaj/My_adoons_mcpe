{
 "format_version": "1.8.0",
 "render_controllers": {
  "controller.render.halo.neon_outline_helmet": {
   "geometry": "Geometry.outline",
   "materials": [
    {
     "*": "Material.outline"
    }
   ],
   "textures": [
    "Texture.outline"
   ],
   "ignore_lighting": true,
   "part_visibility": [
    {
     "*": "query.is_item_name_any('slot.armor.head', 0, 'halo:neon_helmet')"
    }
   ]
  },
  "controller.render.halo.neon_outline_chestplate": {
