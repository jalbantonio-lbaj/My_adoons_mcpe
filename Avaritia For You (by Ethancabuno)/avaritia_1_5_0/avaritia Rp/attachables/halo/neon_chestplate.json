{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "halo:neon_chestplate",
      "materials": {
        "default": "armor",
        "enchanted": "armor_enchanted",
        "outline": "halo_armor_outline",
        "wings": "halo_wing_translucent"
      },
      "textures": {
        "default": "textures/models/armor/neon_halo_chest",
        "enchanted": "textures/misc/enchanted_item_glint",
        "outline": "textures/models/armor/neon_outline",
        "wings": "textures/models/armor/neon_halo_chest"
      },
      "geometry": {
        "default": "geometry.halo.neon_chestplate",
        "outline": "geometry.halo.neon_chestplate_outline",
        "wings": "geometry.halo.neon_wings"
      },
      "render_controllers": [
        "controller.render.armor",
        "controller.render.halo.neon_outline_chestplate",
        "controller.render.halo.neon_wings"
      ],
      "animations": {
        "wings": "controller.animation.halo.wings",
        "folded": "animation.halo.wings_folded",
        "open": "animation.halo.wings_open",
        "opening": "animation.halo.wings_opening",
        "closing": "animation.halo.wings_closing"
      },
      "scripts": {
        "animate": [
          "wings"
        ],
        "parent_setup": "t.bp_avaritia_fly = v.bp_avaritia_fly ?? -1.0;",
        "pre_animation": [
          "variable.neon_fly = (t.bp_avaritia_fly ?? -1.0) > 0.5 ? 1.0 : 0.0;"
        ]
      }
    }
  }
}