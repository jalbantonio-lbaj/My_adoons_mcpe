      },
      "scripts": {
        "parent_setup": "variable.chest_layer_visible = 0.0; t.bp_avaritia_fly = v.bp_avaritia_fly ?? -1.0;",
        "pre_animation": [
          "variable.avaritia_t = query.life_time;",
          "variable.avaritia_vs = query.vertical_speed;",
          "variable.avaritia_ground_t = (query.is_on_ground || query.is_in_water || query.is_riding) ? variable.avaritia_t : (variable.avaritia_ground_t ?? 0.0);",
          "variable.avaritia_move_t = Math.abs(variable.avaritia_vs) > 1.5 ? variable.avaritia_t : (variable.avaritia_move_t ?? 0.0);",
          "variable.avaritia_fall_t = variable.avaritia_vs < -10.0 ? variable.avaritia_t : (variable.avaritia_fall_t ?? 0.0);",
          "variable.avaritia_fly = (variable.avaritia_t - variable.avaritia_ground_t < 0.1) ? 0.0 : ((variable.avaritia_t - variable.avaritia_move_t > 0.4) ? 1.0 : ((variable.avaritia_fall_t == variable.avaritia_t) ? 0.0 : (variable.avaritia_fly ?? 0.0)));",
          "variable.avaritia_sig = t.bp_avaritia_fly ?? -1.0;",
          "variable.avaritia_fly = variable.avaritia_sig >= 0.0 ? variable.avaritia_sig : variable.avaritia_fly;"
        ]
      },
      "render_controllers": [
        "controller.render.armor.normal",
        "controller.render.armor.animate",
        "controller.render.armor.aura",
        {
          "controller.render.avaritia.wings": "variable.avaritia_fly > 0.5"
        },
        {
          "controller.render.armor.aura_wings": "variable.avaritia_fly > 0.5"
        },
        "controller.render.shield_armor",
        "controller.render.armor.aura_shield"
      ]
    }
