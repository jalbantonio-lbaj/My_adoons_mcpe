{
 "format_version": "1.10.0",
 "minecraft:attachable": {
  "description": {
   "identifier": "avaritia:biome_compass_33",
   "render_controllers": [
    "controller.render.item_default"
   ],
   "materials": {
    "default": "entity_alphatest",
    "enchanted": "entity_alphatest_glint"
   },
   "textures": {
    "default": "textures/avaritia/biome_compass/biome_compass",
    "enchanted": "textures/misc/enchanted_item_glint"
   },
   "geometry": {
    "default": "geometry.avaritia.biome_compass"
   },
   "animations": {
    "first_person_hold": "animation.avaritia_bc.item.first_person_hold_33",
    "first_person_other_hold": "animation.avaritia_bc.item.first_person_other_hold_33",
    "third_person_hold": "animation.avaritia_bc.item.third_person_hold_33"
   },
   "scripts": {
    "animate": [
     {
      "first_person_hold": "c.is_first_person && c.item_slot == 'main_hand'"
     },
     {
      "first_person_other_hold": "c.is_first_person && c.item_slot != 'main_hand'"
     },
     {
      "third_person_hold": "!c.is_first_person"
     }
    ],
    "initialize": [
     "variable.current_rotation = math.random(0, 360);",
     "variable.target_rotation = math.random(0, 360);"
    ],
    "pre_animation": [
     "variable.rotation_speed = 0.05;",
     "variable.change_rotation = math.random(0, 55);",
     "variable.target_rotation = (variable.change_rotation < 2) ? math.random(0, 360) : variable.target_rotation;",
     "variable.current_rotation = math.lerprotate(variable.current_rotation, variable.target_rotation, variable.rotation_speed);",
     "variable.current_rotation = math.mod(variable.current_rotation, 360);"
    ]
   }
  }
 }
}