{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "avaritia:snova_sparks",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/avaritia/streak"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(200, 40 + 8 * (variable.radius ?? 6))"
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.3,
        "direction": "outwards",
        "surface_only": true
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.6, 1.1)"
      },
      "minecraft:particle_initial_speed": "(variable.radius ?? 6) * (1.6 + variable.particle_random_2 * 2.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -6,
          0
        ],
        "linear_drag_coefficient": 1.3
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.04 + 0.01 * (variable.radius ?? 6)",
          "0.18 + 0.035 * (variable.radius ?? 6)"
        ],
        "facing_camera_mode": "direction_y",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "math.lerp(math.lerp(1, 0.6, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0) / 0.4, 0, 1)), 0.2, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0.4) / 0.6, 0, 1))",
          "math.lerp(math.lerp(1, 0.97, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0) / 0.4, 0, 1)), 0.78, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0.4) / 0.6, 0, 1))",
          1,
          "math.lerp(math.lerp(1, 0.9, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0) / 0.4, 0, 1)), 0, math.clamp(((variable.particle_age / variable.particle_lifetime) - 0.4) / 0.6, 0, 1))"
        ]
      }
    }
  }
}