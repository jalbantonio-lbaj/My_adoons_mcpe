            "variable.dx ?? 0",
            "variable.dy ?? 0",
            "variable.dz ?? 1"
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.cr ?? 1",
          "variable.cg ?? 1",
