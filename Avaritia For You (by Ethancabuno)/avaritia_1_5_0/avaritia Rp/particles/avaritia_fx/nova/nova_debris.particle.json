{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "avaritia:nova_debris",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/avaritia/shard.png"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(110, 12 + 1.8 * (variable.radius ?? 6))"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.4,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.2
      },
      "minecraft:particle_initial_speed": "(variable.radius ?? 6) * (0.45 + variable.particle_random_3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -11,
          0
        ],
        "linear_drag_coefficient": 0.4
      },
      "minecraft:particle_initial_spin": {
        "rotation": "variable.particle_random_2 * 360",
        "rotation_rate": "(variable.particle_random_3 - 0.5) * 720"
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.07 + 0.1 * variable.particle_random_1",
          "0.07 + 0.1 * variable.particle_random_1"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 16,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            16
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(0.8 + (0.1 - 0.8) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "(0.9 + (0.35 - 0.9) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "(1 + (1 - 1) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "math.pow(1 - math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1), 2.5)"
        ]
      }
    }
  }
}