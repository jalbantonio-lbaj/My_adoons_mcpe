{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "avaritia:nova_sparks",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/avaritia/streak.png"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.01
      },
      "minecraft:emitter_rate_instant": {
        "num_particles": "math.min(240, 30 + 7 * (variable.radius ?? 6))"
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.3,
        "direction": "outwards",
        "surface_only": true
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.0
      },
      "minecraft:particle_initial_speed": "(variable.radius ?? 6) * (1.3 + variable.particle_random_2 * 2.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          -3,
          0
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.035 + 0.01 * (variable.radius ?? 6)",
          "0.16 + 0.03 * (variable.radius ?? 6)"
        ],
        "facing_camera_mode": "lookat_direction",
        "uv": {
          "texture_width": 16,
          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        },
        "direction": {
          "mode": "derive_from_velocity",
          "min_speed_threshold": 0.01
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "0.45 + 0.3 * variable.particle_random_1",
          "0.7 + 0.2 * variable.particle_random_1",
          1,
          "math.pow(1 - math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1), 1.0)"
        ]
      }
    }
  }
}