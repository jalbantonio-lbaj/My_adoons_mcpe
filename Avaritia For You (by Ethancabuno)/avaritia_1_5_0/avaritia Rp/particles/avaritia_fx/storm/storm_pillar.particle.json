          "texture_height": 64,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            16,
            64
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "(1 + (0.62 - 1) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "(1 + (0.33 - 1) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "(1 + (1 - 1) * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
          "math.min(1, math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1) / 0.03) * math.pow(1 - math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1), 1.0)"
