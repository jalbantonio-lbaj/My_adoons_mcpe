      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          "1.5 * (variable.radius ?? 6)",
          0
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 0.55
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(variable.radius ?? 6) * 0.22 * (1 - 0.85 * math.clamp(variable.particle_age / variable.particle_lifetime, 0, 1))",
