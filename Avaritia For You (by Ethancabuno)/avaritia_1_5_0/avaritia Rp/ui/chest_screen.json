            { "rf_disc_slot_wrapper@chest.rf_disc_slot_wrapper": { "offset": [ -35, -20 ] } },
            { "rf_flame_off@chest.rf_flame_off": { "offset": [ -35, 0 ] } },
            { "rf_flame_holder@chest.rf_flame_holder": { "offset": [ -35, 0 ] } },
            { "rf_fuel_slot_wrapper@chest.rf_fuel_slot_wrapper": { "offset": [ -35, 20 ] } },
            { "rf_arrow@chest.rf_arrow": { "offset": [ -3, 0 ] } },
            { "rf_arrow_holder@chest.rf_arrow_holder": { "offset": [ -3, 0 ] } },
            { "rf_output_slot_wrapper@chest.rf_output_slot_wrapper": { "offset": [ 32, 0 ] } }
        ]
    },

    "rf_panel": {
        "type": "panel",
        "controls": [
