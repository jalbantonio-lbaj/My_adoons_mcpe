    ////---------------------------------------------------------------------------
    //// #region small_chest_screen - CHI CHEN DIEU KIEN (modifications)
    ////---------------------------------------------------------------------------
    //// Admin Inventory Viewer (ported from InvSee by r4isen1920, MIT License)
    //// title "_r4ui:inventory:<5 armor flags>:<name>" -> custom large chest with player layout
    "chest_label": {
        "text": "",
        "size": [ "100%c", "100%c" ],
        "$new_custom_name|default": "$container_title",
        "controls": [
            {
                "stack": {
                    "type": "stack_panel",
                    "orientation": "horizontal",
                    "size": [ "100%c", "100%cm" ],
                    "controls": [
                        {
                            "base_label@avaritia_invsee_inventory.label": {
                                "text": "$new_custom_name"
                            }
                        }
                    ]
                }
            }
        ]
    },

    "large_chest_panel_top_half": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "inventory_viewer_grid@avaritia_invsee_inventory.inventory_viewer_grid": {
                            "offset": [ 0, -2.5 ],
                            "ignored": "(not $use_custom_screen)"
                        }
                    }
                ]
            }
        ]
    },

    "large_chest_panel_top_half/large_chest_grid": {
        "ignored": "$use_custom_screen"
    },

    "large_chest_screen": {
        "$container_name": "$container_title",
        "$use_custom_screen": false
    },

    "ender_chest_screen": {
        "$container_name": "$container_title",
        "$use_custom_screen": false
    },

    "shulker_box_screen": {
        "$container_name": "$container_title",
        "$use_custom_screen": false
    },

    "barrel_screen": {
        "$container_name": "$container_title",
        "$use_custom_screen": false
    },

    "small_chest_screen": {
        "$temp_container_title|default": "$container_title",
        "$container_name": "$container_title",
        "$use_custom_screen|default": false,
        "modifications": [
            {
                "array_name": "variables",
                "operation": "insert_back",
                "value": [
                    {
                        "requires": "(not ($container_name - '_r4ui:inventory:' = $container_name))",
                        "$screen_content": "chest.large_chest_panel",
                        "$screen_bg_content": "common.screen_background",
                        "$new_custom_name": "($container_name - ('%.22s' * $container_name))",
                        "$use_custom_screen": true
                    },
                    {
                        "requires": "($temp_container_title = 'ec_9x9_ui')",
                        "$screen_content": "chest.ec_9x9_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'nc_ui')",
                        "$screen_content": "chest.nc_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'comp_ui')",
                        "$screen_content": "chest.comp_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'ic_ui')",
                        "$screen_content": "ic.ic_panel",
                        "$screen_bg_content": "common.screen_background"
                    },
                    {
                        "requires": "($temp_container_title = 'record_furnace_ui')",
                        "$screen_content": "chest.rf_panel",
                        "$screen_bg_content": "common.screen_background"
                    }
                ]
            }
        ]
    }
    //// #endregion
}
