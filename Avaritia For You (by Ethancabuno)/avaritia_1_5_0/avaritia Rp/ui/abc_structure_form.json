{
  "namespace": "abc_structure_form",
  "title": {
    "type": "label",
    "text": "#display_title",
    "size": [
      "100% - 24px",
      10
    ],
    "color": [
      0.18,
      0.2,
      0.22
    ],
    "shadow": false,
    "layer": 4,
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#title_text - 'ABC:STRUCTURE_COORDS|')",
        "target_property_name": "#display_title"
      }
    ]
  },
  "chat_area": {
    "type": "panel",
    "size": [
      "100%",
      98
    ],
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/Black",
          "alpha": 0.65,
          "size": [
            "100%",
            "100%"
          ]
        }
      },
      {
        "heading": {
          "type": "label",
          "text": "Locate result",
          "color": [
            1,
            0.85,
            0.35
          ],
          "shadow": true,
          "size": [
            "100% - 12px",
            12
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            6,
            5
          ],
          "layer": 2,
          "text_alignment": "left"
        }
      }
    ]
  },
  "content": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "instructions": {
          "type": "label",
          "text": "Enter the X and Z coordinates from the result below.",
          "color": [
            1,
            1,
            1
          ],
          "shadow": true,
          "size": [
            "100% - 4px",
            18
          ],
          "text_alignment": "left",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "font_scale_factor": 0.85
        }
      },
      {
        "messages@abc_structure_form.chat_area": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [
            0,
            24
          ]
        }
      },
      {
        "inputs@server_form.custom_form_panel": {
          "size": [
            "100%",
            "100% - 130px"
          ],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [
            0,
            0
          ]
        }
      }
    ]
  },
  "form@server_form.custom_form": {
    "size": [
      390,
      320
    ],
    "max_size": [
      "94%",
      "90%"
    ],
    "$child_control": "abc_structure_form.content",
    "$use_custom_title_control": true,
    "$custom_title_label": "abc_structure_form.title",
    "$title_size": [
      "100% - 24px",
      10
    ],
    "bindings": [
      {
        "binding_name": "#title_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#title_text - 'ABC:STRUCTURE_COORDS|') = #title_text))",
        "target_property_name": "#visible"
      }
    ]
  }
}
