{
  "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "avaritia:black_hole",
      "is_experimental": false,
      "is_spawnable": false,
      "is_summonable": true
    },
    "component_groups": {
      "explode": {
        "minecraft:explode": {
          "max_resistance": 4.0,
          "causes_fire": false,
          "power": 8,
          "fuse_length": 0,
          "fuse_lit": true,
          "destroy_affected_by_griefing": false
        }
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0,
        "height": 0
      },
      "minecraft:type_family": {
        "family": ["inanimate", "black_hole", "void"]
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "self",
                  "value": "black_hole"
                }
              ]
            },
            "event": "kill_all"
          }
        ]
      },
      "minecraft:knockback_resistance": {
        "max": 100,
        "value": 100
      },
      "minecraft:behavior.knockback_roar": {
        "priority": 0,
        "knockback_horizontal_strength": -1,
        "knockback_damage": 0,
        "knockback_range": 16,
        "duration": 0.2,
        "cooldown_time": 0,
        "attack_time": 0
      },
      "minecraft:timer": {
        "looping": false,
        "time": 10,
        "time_down_event": {
          "event": "explode",
          "target": "self"
        }
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "all",
            "deals_damage": false
          }
        ]
      },
      "minecraft:fire_immune": true,
      "minecraft:health": {
        "max": 1,
        "value": 1
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "queue_command": {
          "command": [
            "playsound avaritia.gaping_void @a ~~~"
          ]
        }
      },
      "explode": {
        "add": {
          "component_groups": ["explode"]
        }
      },
      "kill_all": {
        "queue_command": {
          "command": [
            "tag @e[r=15] add blackHole",
            "tag @e[hasitem={item=avaritia:infinity_leggings,location=slot.armor.legs}] remove blackHole",
            "tag @e[m=spectator] remove blackHole",
            "execute as @e[r=15,tag=blackHole] at @s run tp @s ^^^0.1 facing @e[c=1,type=avaritia:black_hole]",
            "execute as @e[r=12,tag=blackHole] at @s run tp @s ^^^0.2 facing @e[c=1,type=avaritia:black_hole]",
            "execute as @e[r=10,tag=blackHole] at @s run tp @s ^^^0.3 facing @e[c=1,type=avaritia:black_hole]",
            "execute as @e[r=9,tag=blackHole] at @s run tp @s ^^^0.4 facing @e[c=1,type=avaritia:black_hole]",
            "execute as @e[r=8,tag=blackHole] at @s run tp @s ^^^0.5 facing @e[c=1,type=avaritia:black_hole]",
            "tag @e remove blackHole",
            "damage @e[r=10] 5 void entity @s",
            "damage @e[r=8] 50 void entity @s",
            "damage @e[r=6] 500 void entity @s",
            "damage @e[r=4] 5000 void entity @s",
            "damage @e[r=2] 50000 void entity @s",
            "tag @a[r=3,m=creative] add creativeKill",
            "tag @a[tag=immortal] remove creativeKill",
            "gamemode survival @a[tag=creativeKill]",
            "kill @e[r=1,tag=!immortal,tag=!all_immunity,family=!void]",
            "gamemode creative @a[tag=creativeKill]",
            "tag @a remove creativeKill",
            "effect @a[r=5] blindness 3 255 true"
          ]
        }
      }
    }
  }
}