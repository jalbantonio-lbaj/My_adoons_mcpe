  "table_progress": {
    "$fill_texture|default": "textures/ui/table_progress_dire",
    "$fill_size|default": [
      21,
      8
    ],
    "$collection_index|default": 82,
    "$max_stack|default": 63.0,
    "type": "image",
    "texture": "$fill_texture",
    "size": "$fill_size",
    "alpha": 0,
    "layer": 7,
    "controls": [
      {
        "progress_fill_wrapper": {
          "type": "collection_panel",
          "size": "$fill_size",
          "collection_name": "container_items",
          "anchor_from": "center",
          "anchor_to": "center",
          "controls": [
            {
              "actual_fill": {
                "type": "image",
                "size": "$fill_size",
                "layer": 7,
                "collection_index": "$collection_index",
                "texture": "$fill_texture",
                "clip_direction": "left",
                "clip_pixelperfect": false,
                "bindings": [
                  {
                    "binding_name": "#inventory_stack_count",
                    "binding_name_override": "#stack_count",
                    "binding_condition": "always",
                    "binding_type": "collection",
                    "binding_collection_name": "container_items"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#stack_count = ''))",
                    "target_property_name": "#visible"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#stack_count - '\u00a7r' - '\u00a7f' - '\u00a7o') * 1)",
                    "target_property_name": "#stack_number"
                  },
                  {
                    "binding_condition": "always",
                    "binding_type": "view",
                    "source_property_name": "(1 - ((#stack_number - 1) / $max_stack))",
                    "target_property_name": "#clip_ratio"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "table_crafted_label": {
    "$label_color|default": [
      0.2,
      0.2,
      0.2
    ],
    "type": "label",
    "text": "#hover_text",
    "color": "$label_color",
    "shadow": false,
    "text_alignment": "center",
    "font_scale_factor": 0.8,
    "layer": 12,
    "anchor_from": "center",
    "anchor_to": "center",
    "bindings": [
      {
        "binding_name": "#hover_text",
        "binding_type": "collection",
        "binding_collection_name": "container_items"
      }
    ]
  },
  "table_crafted_wrap": {
    "$label_color|default": [
      0.2,
      0.2,
      0.2
    ],
    "$collection_index|default": 83,
    "type": "collection_panel",
    "collection_name": "container_items",
    "size": [
      58,
      10
    ],
    "controls": [
      {
        "crafted_label@avaritia.table_crafted_label": {
          "collection_index": "$collection_index",
          "size": [
            58,
            10
          ]
        }
      }
    ]
  }
}
