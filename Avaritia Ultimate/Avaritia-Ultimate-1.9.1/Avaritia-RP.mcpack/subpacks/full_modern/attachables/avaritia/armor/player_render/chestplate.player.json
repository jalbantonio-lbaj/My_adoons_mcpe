        "wing3": "textures/models/armor/infinity/wing/3",
        "wing4": "textures/models/armor/infinity/wing/4",
        "wing5": "textures/models/armor/infinity/wing/5",
        "wing6": "textures/models/armor/infinity/wing/6",
        "wing7": "textures/models/armor/infinity/wing/7",
        "wing8": "textures/models/armor/infinity/wing/8",
        "wing9": "textures/models/armor/infinity/wing/9",
        "wing10": "textures/models/armor/infinity/wing/10",
