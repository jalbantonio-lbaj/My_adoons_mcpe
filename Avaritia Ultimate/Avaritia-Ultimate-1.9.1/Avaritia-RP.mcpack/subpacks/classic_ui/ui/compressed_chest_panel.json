{
  "namespace": "avaritia_cchest",
  "compressed_chest_grid": {
    "type": "grid",
    "size": [
      162,
      486
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [
      9,
      27
    ],
    "grid_item_template": "chest.chest_grid_item",
    "collection_name": "container_items"
  },
  "compressed_chest_top_half": {
    "type": "panel",
    "size": [
      "100%",
      181
    ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      {
        "chest_label@chest.chest_label": {
          "offset": [
            170,
            8
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "localize": true,
          "text": "entity.avaritia:compressed_chest.name"
        }
      },
      {
        "inventory_label@chest.chest_label": {
          "offset": [
            170,
            182
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "localize": true,
          "text": "entity.avaritia:inventory_label.name"
        }
      },
      {
        "scroll@common.scrolling_panel": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [
            162,
            162
          ],
          "offset": [
            174,
            20
          ],
          "$show_background": false,
          "layer": 1,
          "$scroll_size": [
            8,
            "100%"
          ],
          "$scrolling_pane_size": [
            "100% + 18px",
            "100%"
          ],
          "$scrolling_pane_offset": [
            -6,
            0
          ],
          "$scroll_view_port_offset": [
            0,
            0
          ],
          "$scrolling_pane_size_touch": [
            8,
            "100%"
          ],
          "$scrolling_pane_offset_touch": [
            -50,
            0
          ],
          "$scroll_view_port_offset_touch": [
            1,
            0
          ],
          "$scroll_size_touch": [
            8,
            "100% - 4px"
          ],
          "$scroll_bar_contained_touch": false,
          "$scroll_box_visible_touch": true,
          "$scroll_box_offset": [
            -180,
            0
          ],
          "$use_touch_mode": false,
          "$scrolling_content": "avaritia_cchest.compressed_chest_grid"
        }
      }
    ]
  },
  "compressed_chest_panel": {
    "type": "panel",
    "controls": [
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@chest.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [
            500,
            275
          ],
          "layer": 1,
          "controls": [
            {
              "gui_art": {
                "type": "image",
                "texture": "textures/ui/compressed_chest_gui",
                "size": [
                  500,
                  275
                ],
                "layer": 2,
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  0,
                  0
                ]
              }
            },
            {
              "chest_panel": {
                "type": "panel",
                "layer": 5,
                "offset": [
                  0,
                  -8
                ],
                "controls": [
                  {
                    "compressed_chest_top_half@avaritia_cchest.compressed_chest_top_half": {}
                  },
                  {
                    "inventory_panel_bottom_half@common.inventory_panel_bottom_half": {}
                  },
                  {
                    "hotbar_grid@common.hotbar_grid_template": {}
                  },
                  {
                    "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {}
                  },
                  {
                    "flying_item_renderer@common.flying_item_renderer": {
                      "layer": 15
                    }
                  }
                ]
              }
            },
            {
              "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
            },
            {
              "gamepad_cursor@common.gamepad_cursor_button": {}
            },
            {
              "avaritia_close_layer@avaritia_close.close_layer": {
                "$frame_size": [
                  12,
                  12
                ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [
                  341,
                  189
                ],
                "controls": [
                  {
                    "avaritia_close_btn@avaritia_close.close_button": {
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [
                        0,
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
