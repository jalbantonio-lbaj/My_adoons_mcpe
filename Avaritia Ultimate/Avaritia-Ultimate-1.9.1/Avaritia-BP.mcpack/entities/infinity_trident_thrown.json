{
  "format_version": "1.21.20",
  "minecraft:entity": {
    "description": {
      "identifier": "avaritia:infinity_trident_thrown",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "runtime_identifier": "minecraft:snowball"
    },
    "component_groups": {
      "avaritia:strike_lightning": {
        "minecraft:spawn_entity": {
          "entities": [
            {
              "min_wait_time": 0,
              "max_wait_time": 0,
              "spawn_entity": "minecraft:lightning_bolt"
            }
          ]
        }
      },
      "avaritia:despawn_timer": {
        "minecraft:timer": {
          "looping": false,
          "time": 0.5,
          "time_down_event": {
            "event": "avaritia:despawn_now"
          }
        }
      },
      "avaritia:despawn_now": {
        "minecraft:instant_despawn": {}
      }
    },
    "components": {
      "minecraft:collision_box": {
        "width": 0.25,
        "height": 0.35
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:type_family": {
        "family": ["trident", "inanimate"]
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 7,
          "use_motion_prediction_hints": true
        }
      },
      "minecraft:projectile": {
        "on_hit": {
          "impact_damage": {
            "damage": 101,
            "knockback": true,
            "semi_random_diff_damage": false,
            "destroy_on_hit": false
          },
          "stick_in_ground": {
            "shake_time": 0
          },
          "definition_event": {
            "event_trigger": {
              "event": "avaritia:on_impact"
            }
          }
        },
        "liquid_inertia": 0.99,
        "hit_sound": "item.trident.hit",
        "hit_ground_sound": "item.trident.hit_ground",
        "power": 4,
        "gravity": 0.10,
        "uncertainty_base": 1,
        "uncertainty_multiplier": 0,
        "stop_on_hurt": true,
        "anchor": 1,
        "should_bounce": true,
        "multiple_targets": false,
        "offset": [0, -0.1, 0]
      }
    },
    "events": {
      "avaritia:on_impact": {
        "add": {
          "component_groups": ["avaritia:strike_lightning", "avaritia:despawn_timer"]
        }
      },
      "avaritia:despawn_now": {
        "add": {
          "component_groups": ["avaritia:despawn_now"]
        }
      }
    }
  }
}
