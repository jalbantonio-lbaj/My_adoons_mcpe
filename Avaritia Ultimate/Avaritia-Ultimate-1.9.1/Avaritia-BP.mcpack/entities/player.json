          ]
        }
      },
      "infinity_immortality": {
        "queue_command": {
          "command": [
            "playsound random.totem",
            "particle minecraft:totem_particle ~ ~ ~",
            "particle minecraft:totem_particle ~ ~1 ~",
            "particle minecraft:totem_particle ~ ~2 ~",
            "damage @s 0 none",
            "effect @s resistance 5 255 true",
            "effect @s regeneration 5 255 true",
            "scriptevent avaritia:infinity_totem_used"
          ]
        }
      },
      "infinity_totem_event": {
        "add": {
          "component_groups": [
            "infinity_totem"
          ]
        }
      },
      "infinity_totem_break_event": {
        "remove": {
          "component_groups": [
            "infinity_totem"
          ]
        }
      },

