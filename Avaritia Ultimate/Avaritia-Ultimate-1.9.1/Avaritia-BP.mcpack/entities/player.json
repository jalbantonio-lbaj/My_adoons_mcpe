    "events": {
      "reset_player": {
        "add": {
          "component_groups": [
            "reset_player"
          ]
        },
        "remove": {
          "component_groups": [
            "infinity_totem",
            "infinity_leggings",
            "infinity_boots",
            "infinity_armor",
            "avaritia_kb_10",
            "avaritia_kb_50"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "reset_player"
          ]
        }
      },
      "minecraft:gain_raid_omen": {
        "add": {
          "component_groups": [
            "minecraft:add_raid_omen"
          ]
        }
      },
      "minecraft:clear_add_raid_omen": {
        "remove": {
          "component_groups": [
            "minecraft:add_raid_omen"
          ]
