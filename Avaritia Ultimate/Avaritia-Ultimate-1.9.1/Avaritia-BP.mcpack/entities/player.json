                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "head",
                  "value": "avaritia:infinity_helmet"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "torso",
                  "value": "avaritia:infinity_chestplate"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "leg",
                  "value": "avaritia:infinity_leggings"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "feet",
                  "value": "avaritia:infinity_boots"
