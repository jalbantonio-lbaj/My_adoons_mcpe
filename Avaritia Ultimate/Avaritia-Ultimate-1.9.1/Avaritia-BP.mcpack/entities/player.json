{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "minecraft:player",
      "spawn_category": "creature",
      "is_spawnable": false,
      "is_summonable": false
    },
    "component_groups": {
      "reset_player": {
        "minecraft:damage_sensor": {
          "triggers": {
            "cause": "fall",
            "deals_damage": true
          }
        },
        "minecraft:type_family": {
          "family": [
            "player"
          ]
        },
        "minecraft:health": {
          "value": 20,
          "max": 20,
          "min": 0
        },
        "minecraft:movement": {
          "value": 0.1
        },
        "minecraft:underwater_movement": {
          "value": 0.02
        },
        "minecraft:lava_movement": {
          "value": 0.02
        },
        "minecraft:flying_speed": {
          "value": 0.02
        },
        "minecraft:knockback_resistance": {
          "value": 0,
          "max": 1
        },
        "minecraft:physics": {
          "has_gravity": true
        }
      },
      "minecraft:add_raid_omen": {
        "minecraft:spell_effects": {
          "add_effects": [
            {
              "effect": "raid_omen",
              "duration": 30,
              "display_on_screen_animation": true
            }
          ],
          "remove_effects": "bad_omen"
        },
        "minecraft:timer": {
          "time": [
            0.0,
            0.0
          ],
          "looping": false,
          "time_down_event": {
            "event": "minecraft:clear_add_raid_omen",
            "target": "self"
          }
        }
      },
      "minecraft:clear_raid_omen_spell_effect": {
        "minecraft:spell_effects": {}
      },
      "minecraft:raid_trigger": {
        "minecraft:raid_trigger": {
          "triggered_event": {
            "event": "minecraft:remove_raid_trigger",
            "target": "self"
          }
        }
      },
      "is_flying": {
        "minecraft:physics": {
          "has_gravity": false
        }
      },
      "infinity_totem": {
        "minecraft:damage_sensor": {
          "triggers": [
            {
              "on_damage": {
                "filters": {
                  "test": "has_damage",
                  "subject": "self",
                  "operator": "==",
                  "value": "fatal"
                },
                "event": "infinity_immortality"
              },
              "deals_damage": false
            }
          ]
        }
      },
      "infinity_leggings": {
        "minecraft:knockback_resistance": {
          "value": 500000000,
          "max": 500000000
