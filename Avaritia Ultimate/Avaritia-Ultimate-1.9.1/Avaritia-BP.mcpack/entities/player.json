                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "torso",
                  "value": "avaritia:blaze_chestplate"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "leg",
                  "value": "avaritia:blaze_leggings"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "feet",
                  "value": "avaritia:blaze_boots"
                }
