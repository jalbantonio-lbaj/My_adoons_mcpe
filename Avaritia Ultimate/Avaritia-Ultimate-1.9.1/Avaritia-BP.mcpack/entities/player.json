                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "torso",
                  "value": "avaritia:crystal_chestplate"
                },
                {
                  "test": "has_equipment",
                  "subject": "self",
                  "domain": "leg",
                  "value": "avaritia:crystal_leggings"
