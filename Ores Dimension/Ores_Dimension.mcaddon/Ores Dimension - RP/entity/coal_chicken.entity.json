{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "oredim:coal_chicken",
      "min_engine_version": "1.12.0",
      "materials": {
        "default": "chicken",
        "cold": "chicken_cold",
        "legs": "chicken_legs"
      },
      "textures": {
        "default": "textures/entity/oredim/coal/chicken__default",
        "warm": "textures/entity/oredim/coal/chicken__warm",
        "cold": "textures/entity/oredim/coal/chicken__cold",
        "baby_default": "textures/entity/oredim/coal/chicken__baby_default",
        "baby_warm": "textures/entity/oredim/coal/chicken__baby_warm",
        "baby_cold": "textures/entity/oredim/coal/chicken__baby_cold"
      },
      "geometry": {
        "default": "geometry.oredim.chicken_v1_12",
        "warm": "geometry.oredim.chicken_v1_12",
        "cold": "geometry.oredim.chicken_cold",
        "baby": "geometry.oredim.chicken_baby"
      },
      "animations": {
        "move": "animation.chicken.move",
        "general": "animation.chicken.general",
        "look_at_target": "animation.common.look_at_target"
      },
      "scripts": {
        "scale": "query.is_baby ? 2.0 : 1.0",
        "pre_animation": [
          "t.variant = query.property('minecraft:climate_variant');",
          "v.index = (t.variant == 'temperate') ? 0 : ((t.variant == 'warm') ? 1 : 2);",
          "v.is_cold = t.variant == 'cold';"
        ],
        "animate": [
          "general",
          {
            "move": "query.modified_move_speed"
          },
          "look_at_target"
        ]
      },
      "render_controllers": [
        "controller.render.chicken.v3"
      ],
      "spawn_egg": {
        "base_color": "#121215",
        "overlay_color": "#7c7c84"
      }
    }
  }
}